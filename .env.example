# Demo Mode — for live event demos only. When true, the app runs with no AI credentials.
# Grouping uses real deterministic computation; lesson plans and quizzes use recorded fixtures.
VITE_DEMO_MODE=TRUE

# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key

# Azure OpenAI API Configuration
VITE_AZURE_OPENAI_ENDPOINT=https://daita.openai.azure.com/
VITE_AZURE_OPENAI_API_KEY=your_azure_openai_api_key
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-5.4
VITE_AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Server-Side Configuration (server scripts only — never prefix with VITE_)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
