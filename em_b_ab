INSERT INTO em_modules (id, level_code, parent_id, order_index, title, overview, big_ideas, standards, standards_summary, academic_vocabulary, common_misconceptions, concepts, duration_days) VALUES ('em8_m2', 'EM8', 'em8', 2, 'Linear Equations and Algebraic Reasoning', 'Students analyze slope and intercepts and solve linear equations including pairs of simultaneous linear equations through graphing and tables and using technology. They move between different representations of linear functions.', '["Linear Equations: Analyze slope and intercepts and solve linear equations including pairs of simultaneous linear equations through graphing and tables and using technology.", "Multiple Representations of Functions: Move between different representations of linear functions (i.e., equation, graph, table, and context), sketch and analyze graphs, use similar triangles to visualize slope and rate of change with equations containing rational number coefficients."]'::jsonb, '[{"code": "8.EE.7", "text": "Solve linear equations in one variable. Give examples of linear equations in one variable with one solution, infinitely many solutions, or no solutions. Show which of these possibilities is the case by successively transforming the given equation into simpler forms, until an equivalent equation of the form x = a, a = a, or a = b results (where a and b are different numbers)."}]'::jsonb, 'Analyze and solve linear equations and pairs of simultaneous linear equations.', '["expression", "like terms", "balance", "equation", "equality", "equivalent expressions", "unknowns", "field axioms (commutativity, distributivity, identity elements)", "order of operations", "parenthesis", "exponents", "solution (one solution, no solution, infinitely many solutions)"]'::jsonb, '["Students consider that there is just one ''correct'' expression.", "Students consider that in an equation, there is an answer and an expression only rather than two equivalent expressions.", "Students assume an answer of 0 and no solution are the same.", "Students assume often times that if there are parenthesis in an expression that this expression must represent only the distributive property."]'::jsonb, '["The eighth grade domain ''Expressions and Equations'' addresses the concepts of variables, constraints, and equality in real world context. Quantities express relationships between variables and given constraints with symbolism such as the mathematical operations, parentheses, variables, and constants.", "Equations express an equivalent relationship between two quantities (expressions). To solve an equation means to find values of the variable(s) that make the equation true.", "Algebraic methods of altering linear equation using the distributive property and collecting like-terms, may be used to solve an equation.", "Linear equations are a specific type of equation and may be represented graphically by a line. One formula for a linear equation in two variables, y = mx+b, highlights the slope of that line with the variable m, while x and y represent input and output variables and b represents where the line crosses the y-axis on the graph.", "A linear equation in two variables has an infinite number of solution sets or pairs of x and y values which make the equation true. A linear equation in one variable may have one, no, or infinitely many solutions. If an equation has no solutions then it is not a true statement of equivalence for any values. If an equation is true regardless of what values are substituted for any variables then it has infinite solutions and is called an ''identity.''"]'::jsonb, 9) ON CONFLICT (id) DO UPDATE SET level_code = EXCLUDED.level_code, title = EXCLUDED.title, overview = EXCLUDED.overview, big_ideas = EXCLUDED.big_ideas, standards = EXCLUDED.standards, standards_summary = EXCLUDED.standards_summary, academic_vocabulary = EXCLUDED.academic_vocabulary, common_misconceptions = EXCLUDED.common_misconceptions, concepts = EXCLUDED.concepts, duration_days = EXCLUDED.duration_days, updated_at = now();
INSERT INTO em_modules (id, level_code, parent_id, order_index, title, overview, big_ideas, standards, standards_summary, academic_vocabulary, common_misconceptions, concepts, duration_days) VALUES ('em9a1_m1', 'EM9_ALG1', 'em9_algebra1', 1, 'Function Investigations', 'Students investigate data sets by table and graph and using technology; they fit and interpret functions to model the data between two quantities.', '["Function Investigations: Students investigate data sets by table and graph and using technology; they fit and interpret functions to model the data between two quantities. Students interpret information from the functions, noticing key features and symmetries. Students develop understanding of the meaning of the function and how it represents the data that it is modeling."]'::jsonb, '[{"code": "F-IF", "text": "Interpret functions that arise in applications in terms of the context. Analyze functions using different representations."}, {"code": "F-BF", "text": "Build a function that models a relationship between two quantities."}, {"code": "F-LE", "text": "Construct linear models and solve problems."}]'::jsonb, 'Interpret functions arising in applications; analyze functions using different representations; build linear models.', '["slope", "intercepts", "linear relationship", "linear function", "ordered pair", "t-table (table of values)", "rate of change", "increasing", "decreasing"]'::jsonb, '["Interchanging meanings: Believing the slope represents where the line crosses the y-axis (y-intercept) and vice versa.", "Interpreting slope direction: Not understanding that a positive slope indicates an increasing line, while a negative slope indicates a decreasing line.", "Graphing and interpreting: Assuming the line must go through the origin — thinking that every linear function must pass through the point (0, 0).", "Misreading the scale: Incorrectly interpreting the values on the x and y axes when plotting points.", "Not recognizing constant rate of change: Failing to understand that the slope represents a constant change in y for every change in x.", "Variable confusion: Thinking that the variable in the equation always represents the x-coordinate.", "Not identifying linear relationships: Failing to recognize situations in real life that can be modeled by a linear function.", "Extrapolation errors: Making unreasonable predictions beyond the data range of a linear model.", "Distance v Time errors: A steep line means the object is at a higher elevation; a horizontal line means the object is moving slowly; a downward-sloping line means the object is slowing down; a straight diagonal line means the object is speeding up."]'::jsonb, '["Focus on graph shape and what it represents, how the quantities change over time, multiple representations of the same function"]'::jsonb, 6) ON CONFLICT (id) DO UPDATE SET level_code = EXCLUDED.level_code, title = EXCLUDED.title, overview = EXCLUDED.overview, big_ideas = EXCLUDED.big_ideas, standards = EXCLUDED.standards, standards_summary = EXCLUDED.standards_summary, academic_vocabulary = EXCLUDED.academic_vocabulary, common_misconceptions = EXCLUDED.common_misconceptions, concepts = EXCLUDED.concepts, duration_days = EXCLUDED.duration_days, updated_at = now();
INSERT INTO em_modules (id, level_code, parent_id, order_index, title, overview, big_ideas, standards, standards_summary, academic_vocabulary, common_misconceptions, concepts, duration_days) VALUES ('em9a1_m2', 'EM9_ALG1', 'em9_algebra1', 2, 'Model with Functions', 'Students will investigate data sets by table and graph, and fit and interpret functions to model data between two quantities. Students will interpret information from functions and notice key features and symmetries.', '["Model with Functions: Students will investigate data sets by table and graph, and fit and interpret functions to model data between two quantities. Students will interpret information from functions and notice key features and symmetries. Students will develop understanding of the meaning of the function and how it represents the data that it is modeling."]'::jsonb, '[{"code": "F-IF", "text": "Interpret functions that arise in applications in terms of the context. Analyze functions using different representations."}, {"code": "F-BF", "text": "Build a function that models a relationship between two quantities."}, {"code": "F-LE", "text": "Construct linear models and solve problems."}]'::jsonb, 'Interpret functions arising in applications; analyze functions using different representations; build linear models.', '["linear function", "intercepts", "slope", "increasing or decreasing", "positive or negative"]'::jsonb, '["Interpreting the linear model: Not recognizing when a real-world situation is not accurately modeled by a linear equation.", "Assuming the linear model applies to extreme values outside the data range.", "Failing to understand that the y-intercept represents a starting point in a real-world context.", "Algebraic manipulation: Making errors in calculating slope using the formula (change in y / change in x).", "Incorrectly substituting values into a linear equation to find a solution.", "Not properly interpreting negative values in the equation.", "Real-world application: Choosing the wrong variables to represent quantities in a problem.", "Not considering units when interpreting the slope and y-intercept.", "Assuming a linear relationship exists between two variables without analyzing the data first.", "Extrapolation errors: Making unreasonable predictions beyond the data range of a linear model."]'::jsonb, '["Focus on how a mathematical statement or equation can represent the quantities in a given context. Students explore multiple representations of the same function."]'::jsonb, 6) ON CONFLICT (id) DO UPDATE SET level_code = EXCLUDED.level_code, title = EXCLUDED.title, overview = EXCLUDED.overview, big_ideas = EXCLUDED.big_ideas, standards = EXCLUDED.standards, standards_summary = EXCLUDED.standards_summary, academic_vocabulary = EXCLUDED.academic_vocabulary, common_misconceptions = EXCLUDED.common_misconceptions, concepts = EXCLUDED.concepts, duration_days = EXCLUDED.duration_days, updated_at = now();
INSERT INTO em_modules (id, level_code, parent_id, order_index, title, overview, big_ideas, standards, standards_summary, academic_vocabulary, common_misconceptions, concepts, duration_days) VALUES ('em9a1_m3', 'EM9_ALG1', 'em9_algebra1', 3, 'Systems of Equations', 'Students investigate real situations that include data for which systems of 1 or 2 equations are helpful, paying attention to units. Students use technology tools strategically to find their solutions and approximate solutions.', '["Systems of Equations: Students investigate real situations that include data for which systems of 1 or 2 equations are helpful, paying attention to units. Students use technology tools strategically to find their solutions and approximate solutions, constructing viable arguments, interpreting the meaning of the results, and communicating them in multidimensional ways."]'::jsonb, '[{"code": "A-REI", "text": "Solve equations in one variable. Solve systems of equations. Represent and solve equations graphically."}, {"code": "A-SSE", "text": "Interpret the structure of expressions."}, {"code": "F-LE", "text": "Construct linear models and solve problems."}]'::jsonb, 'Solve equations in one variable; solve systems of equations; represent and solve equations graphically.', '["system of equations", "solution to a system of equations", "ordered pair", "intersect", "variable"]'::jsonb, '["Thinking a system always has one solution: Students might assume that every system of equations will have a single solution point, not realizing that parallel lines (no solution) or identical lines (infinite solutions) can occur.", "Misinterpreting the graph intersection: Not understanding that the point where two lines intersect on a graph represents the solution to the system of equations.", "Solving only one equation: Attempting to solve a system of equations by manipulating only one of the equations, ignoring the need to find a solution that satisfies both equations simultaneously.", "Incorrect substitution: When using the substitution method, substituting incorrectly by not isolating a variable properly in one equation before plugging it into the other.", "Not checking for extraneous solutions: Failing to check if the solution obtained actually satisfies both original equations, which can lead to including extraneous solutions.", "Confusing slope and y-intercept: When graphing lines, mixing up the values of the slope and y-intercept, leading to incorrect line placement.", "Not understanding the concept of elimination: When using the elimination method, not properly manipulating equations to eliminate one variable, leading to incorrect calculations."]'::jsonb, '["Focus on graph shape and what it represents, how the quantities change over time, multiple representations of the same function"]'::jsonb, 6) ON CONFLICT (id) DO UPDATE SET level_code = EXCLUDED.level_code, title = EXCLUDED.title, overview = EXCLUDED.overview, big_ideas = EXCLUDED.big_ideas, standards = EXCLUDED.standards, standards_summary = EXCLUDED.standards_summary, academic_vocabulary = EXCLUDED.academic_vocabulary, common_misconceptions = EXCLUDED.common_misconceptions, concepts = EXCLUDED.concepts, duration_days = EXCLUDED.duration_days, updated_at = now();
INSERT INTO em_modules (id, level_code, parent_id, order_index, title, overview, big_ideas, standards, standards_summary, academic_vocabulary, common_misconceptions, concepts, duration_days) VALUES ('em9geo_m1', 'EM9_GEO', 'em9_geometry', 1, 'Points and Shapes', 'Solve problems involving geometric shapes in the coordinate plane using dynamic geometric software to apply the distance formula, Pythagorean Theorem, and slope in solving problems. Find areas and perimeters of triangles and rectangles in the coordinate plane.', '["Points and Shapes: Solve problems involving geometric shapes in the coordinate plane using dynamic geometric software to apply the distance formula, Pythagorean Theorem, and slope in solving problems. Find areas and perimeters of triangles and rectangles in the coordinate plane."]'::jsonb, '[{"code": "G-GPE", "text": "Use coordinates to prove simple geometric theorems algebraically."}]'::jsonb, 'Use coordinates to prove simple geometric theorems algebraically.', '["coordinate plane", "ordered pair", "slope", "perimeter", "area", "hypotenuse"]'::jsonb, '["Confusing (x, y) Order — Students sometimes reverse the x- and y-coordinates when plotting points.", "Dropping the Square Root — Students might forget to take the square root at the end of the distance formula calculation or to find a missing value in the Pythagorean Theorem.", "Mixing Up Components of Distance Formula and Pythagorean Theorem — Not recognizing when to apply the appropriate method based on problem context and given information.", "Thinking Parallel Lines Have the Same Y-Intercept — Assuming that all parallel lines overlap instead of just having the same slope.", "Flipping Signs for Perpendicular Slopes — Knowing perpendicular slopes are negative reciprocals but incorrectly applying the negative sign."]'::jsonb, '["Focus on the Pythagorean Theorem and how to utilize Pythagorean Theorem to calculate distance on a coordinate plane, including finding areas and perimeters."]'::jsonb, 7) ON CONFLICT (id) DO UPDATE SET level_code = EXCLUDED.level_code, title = EXCLUDED.title, overview = EXCLUDED.overview, big_ideas = EXCLUDED.big_ideas, standards = EXCLUDED.standards, standards_summary = EXCLUDED.standards_summary, academic_vocabulary = EXCLUDED.academic_vocabulary, common_misconceptions = EXCLUDED.common_misconceptions, concepts = EXCLUDED.concepts, duration_days = EXCLUDED.duration_days, updated_at = now();
INSERT INTO em_modules (id, level_code, parent_id, order_index, title, overview, big_ideas, standards, standards_summary, academic_vocabulary, common_misconceptions, concepts, duration_days) VALUES ('em9geo_m2', 'EM9_GEO', 'em9_geometry', 2, 'Transformations', 'Understand rotations, reflections, and translations of regular polygons, quadrilaterals, angles, and line segments. Identify transformations, through investigation, that move a figure back onto itself, using that process to prove congruence.', '["Transformations: Understand rotations, reflections, and translations of regular polygons, quadrilaterals, angles, and line segments. Identify transformations, through investigation, that move a figure back onto itself, using that process to prove congruence."]'::jsonb, '[{"code": "G-CO", "text": "Experiment with transformations in the plane."}]'::jsonb, 'Experiment with transformations in the plane.', '["transformation", "rigid motion", "translation", "reflection", "rotation", "preimage", "image", "congruence"]'::jsonb, '["Thinking Transformations Change Shape or Size — Some students believe that translations, reflections, and rotations distort figures, rather than preserving their size and angles.", "Confusing Different Transformations — Students may mix up translations, reflections, and rotations, especially when transformations are combined.", "Not Understanding the Direction of Rotations — Many students struggle with counterclockwise (positive) and clockwise (negative) rotation conventions.", "Assuming All Rotations Are About the Origin — Some students forget that rotations can happen around any point, not just (0,0).", "Forgetting the Line of Reflection — Students may think that reflecting over a line just flips the shape without considering equal distance from the line.", "Incorrectly Applying Coordinate Rules — Students often struggle with the formulas for reflections and rotations (e.g., reflecting over the y-axis should negate the x-coordinate).", "Forgetting to Apply the Same Transformation to All Points — Some students only transform part of a figure instead of every point.", "Not Keeping Track of Preimage and Image — Students may confuse which shape is the original (preimage) and which is the transformed (image)."]'::jsonb, '["Focus on the criteria for each rigid motion transformation and begin to discuss how rigid motion transformations prove congruence."]'::jsonb, 7) ON CONFLICT (id) DO UPDATE SET level_code = EXCLUDED.level_code, title = EXCLUDED.title, overview = EXCLUDED.overview, big_ideas = EXCLUDED.big_ideas, standards = EXCLUDED.standards, standards_summary = EXCLUDED.standards_summary, academic_vocabulary = EXCLUDED.academic_vocabulary, common_misconceptions = EXCLUDED.common_misconceptions, concepts = EXCLUDED.concepts, duration_days = EXCLUDED.duration_days, updated_at = now();
INSERT INTO em_modules (id, level_code, parent_id, order_index, title, overview, big_ideas, standards, standards_summary, academic_vocabulary, common_misconceptions, concepts, duration_days) VALUES ('em9geo_m3', 'EM9_GEO', 'em9_geometry', 3, 'Triangle Congruence', 'Investigate triangles and their congruence over rigid transformations verifying findings using triangle congruence theorems (ASA, SSS, SAS, AAS, and HL) and other geometric properties, including vertical angles, angles created by transversals across parallel lines, and bisectors.', '["Triangle Congruence: Investigate triangles and their congruence over rigid transformations verifying findings using triangle congruence theorems (ASA, SSS, SAS, AAS, and HL) and other geometric properties, including vertical angles, angles created by transversals across parallel lines, and bisectors."]'::jsonb, '[{"code": "G-CO", "text": "Understand congruence in terms of rigid motions."}]'::jsonb, 'Understand congruence in terms of rigid motions.', '["congruent triangles", "rigid motion transformation", "corresponding angles", "corresponding sides", "right triangle"]'::jsonb, '["Thinking SSA (Side-Side-Angle) Proves Congruence — Students often mistakenly believe that SSA is a valid triangle congruence theorem, but it does not always guarantee congruence.", "Confusing AAS and ASA — Students sometimes mix up Angle-Angle-Side (AAS) and Angle-Side-Angle (ASA), not realizing that ASA requires the included side.", "Believing AAA Proves Congruence — Students may assume that if two triangles have equal angles, they must be congruent, forgetting that AAA only proves similarity, not congruence.", "Thinking HL Applies to All Triangles — Some students mistakenly try to use the Hypotenuse-Leg (HL) theorem for non-right triangles.", "Believing Figures Must Be Oriented the Same Way to Be Congruent — Some students think two triangles must have the same orientation to be congruent, not recognizing that transformations can reposition them."]'::jsonb, '["Focus on the different ways to show triangle congruence (rigid motion, congruence theorems)."]'::jsonb, 6) ON CONFLICT (id) DO UPDATE SET level_code = EXCLUDED.level_code, title = EXCLUDED.title, overview = EXCLUDED.overview, big_ideas = EXCLUDED.big_ideas, standards = EXCLUDED.standards, standards_summary = EXCLUDED.standards_summary, academic_vocabulary = EXCLUDED.academic_vocabulary, common_misconceptions = EXCLUDED.common_misconceptions, concepts = EXCLUDED.concepts, duration_days = EXCLUDED.duration_days, updated_at = now();
