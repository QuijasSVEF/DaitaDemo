CREATE OR REPLACE FUNCTION generate_lesson_plan(
  p_grade_level TEXT,
  p_last_lesson TEXT,
  p_struggled_areas TEXT[],
  p_student_id INTEGER,
  p_exit_ticket_id UUID
)
RETURNS jsonb
