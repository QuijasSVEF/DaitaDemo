LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public'
AS $$
BEGIN
  RETURN QUERY
  SELECT
    c.plaintext_password,
    c.temp_password,
    c.password_last_changed
  FROM coaches c
  WHERE c.id = p_coach_id;
END;
$$;


